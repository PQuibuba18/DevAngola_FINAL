# ============================================================
# DevAngola Backend — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche com os teus valores.
# NUNCA commitas o .env — está no .gitignore.
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Base de dados (Neon PostgreSQL) ──────────────────────────
# Obtém em: neon.tech → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Autenticação ─────────────────────────────────────────────
# Gera com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=gera_uma_string_longa_e_aleatoria_aqui

# ── Frontend (para CORS) ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Cloudinary (uploads de imagens e ficheiros) ───────────────
# Obtém em: cloudinary.com → Dashboard → API Keys
# Free tier: 25 GB storage, 25 GB egress/mês, sem cartão de crédito
# Sem estas variáveis, uploads ficam em backend/uploads/ (apenas local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
